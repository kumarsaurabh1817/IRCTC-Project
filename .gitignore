# Dependencies and package-manager caches (all services)
node_modules/
.npm/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/

# Local configuration and secrets; keep shareable templates
.env
.env.*
*.env
!.env.example
!.env.*.example
!*.env.example
secrets/
credentials/
*.pem
*.key
*.p12
*.pfx

# Runtime logs and reports
logs/
log/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Frontend build output and generated Prisma clients
dist/
build/
out/
**/src/generated/prisma/
*.tsbuildinfo

# Coverage, tooling caches, and temporary files
coverage/
.nyc_output/
.vite/
.cache/
.eslintcache
.turbo/
tmp/
temp/
*.tmp
*.swp
*.swo
*~

# Local database artifacts (do not ignore Prisma migration SQL)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.dump
*.backup

# Local Compose overrides and optional bind-mounted data
compose.override.yml
compose.override.yaml
docker-compose.override.yml
docker-compose.override.yaml
/docker-data/

# Personal editor settings and operating-system files
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Intentionally tracked: package-lock.json, .env.example,
# Prisma schemas/migrations, Docker configuration, and formatter configuration.
